<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:ns1="http://purl.obolibrary.org/obo/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:sca="https://example.org/cabot-audit/ontology/"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/rawInvoiceNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">rawInvoiceNumber</rdfs:label>
    <rdfs:label xml:lang="zh">原始发票编号</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Invoice reference exactly as supplied, including leading zeroes.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/BuyerLegalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">BuyerLegalEntity</rdfs:label>
    <rdfs:label xml:lang="zh">采购法人</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">A legal entity against whose payable account transactions are reconciled.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
    <rdfs:subClassOf rdf:resource="https://example.org/cabot-audit/ontology/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/OpenPayment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/PaymentStatus"/>
    <rdfs:label xml:lang="en">OpenPayment</rdfs:label>
    <rdfs:label xml:lang="zh">未结</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The OpenPayment value in the PaymentStatus vocabulary.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/REC-05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/AuditRule"/>
    <sca:ruleId>REC-05</sca:ruleId>
    <sca:ruleVersion>0.1.0-dev</sca:ruleVersion>
    <rdfs:label xml:lang="en">REC-05</rdfs:label>
    <rdfs:label xml:lang="zh">付款金额一致性</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Comparable paid or received amounts differ under the approved payment scope and allocation policy.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
    <rdfs:seeAlso rdf:resource="https://example.org/cabot-audit/ontology/PaymentDifference"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/Confirmed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/ReviewDisposition"/>
    <rdfs:label xml:lang="en">Confirmed</rdfs:label>
    <rdfs:label xml:lang="zh">已确认</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The Confirmed value in the ReviewDisposition vocabulary.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/scaudit.owl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>0.1.0-dev</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://example.org/cabot-audit/ontology/releases/0.1.0-dev/scaudit.owl"/>
    <owl:imports rdf:resource="https://example.org/cabot-audit/ontology/imports/metadata.owl"/>
    <rdfs:label xml:lang="zh">Cabot Scope 2 对账本体</rdfs:label>
    <rdfs:label xml:lang="en">Cabot Scope 2 Reconciliation Ontology</rdfs:label>
    <dcterms:description xml:lang="en">Development-only semantic model. All examples are synthetic. No audit engine is implemented.</dcterms:description>
    <dcterms:creator>Cabot MVP project maintainers (business owner to be assigned)</dcterms:creator>
    <dcterms:license>Internal development draft; no public license granted.</dcterms:license>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/invoiceDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">invoiceDate</rdfs:label>
    <rdfs:label xml:lang="zh">发票日期</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The date asserted for the invoice in a source observation.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/evaluationInRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/cabot-audit/ontology/RuleEvaluation"/>
    <rdfs:range rdf:resource="https://example.org/cabot-audit/ontology/ReconciliationRun"/>
    <rdfs:label xml:lang="en">evaluationInRun</rdfs:label>
    <rdfs:label xml:lang="zh">评估所属批次</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Identifies the evaluation run.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/snapshotFromDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/cabot-audit/ontology/BalanceSnapshot"/>
    <rdfs:range rdf:resource="https://example.org/cabot-audit/ontology/SourceDataset"/>
    <rdfs:label xml:lang="en">snapshotFromDataset</rdfs:label>
    <rdfs:label xml:lang="zh">余额来源快照</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Identifies the dataset from which the balance was obtained.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/PartiallyPaid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/PaymentStatus"/>
    <rdfs:label xml:lang="en">PartiallyPaid</rdfs:label>
    <rdfs:label xml:lang="zh">部分已付</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The PartiallyPaid value in the PaymentStatus vocabulary.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/supplierComment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">supplierComment</rdfs:label>
    <rdfs:label xml:lang="zh">供应商备注</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Supplier-provided text treated as data, not instructions.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/accountSupplier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/cabot-audit/ontology/SupplierAccount"/>
    <rdfs:range rdf:resource="https://example.org/cabot-audit/ontology/Supplier"/>
    <rdfs:label xml:lang="en">accountSupplier</rdfs:label>
    <rdfs:label xml:lang="zh">账户供应商</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Identifies the supplier participating in the account.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/sourceRow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">sourceRow</rdfs:label>
    <rdfs:label xml:lang="zh">来源行号</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">One-based row number in the source file including its header.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/absoluteVarianceAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">absoluteVarianceAmount</rdfs:label>
    <rdfs:label xml:lang="zh">绝对差额</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The absolute magnitude of a variance, not a confirmed loss.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/evaluationUsesSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/cabot-audit/ontology/RuleEvaluation"/>
    <rdfs:range rdf:resource="https://example.org/cabot-audit/ontology/BalanceSnapshot"/>
    <rdfs:label xml:lang="en">evaluationUsesSnapshot</rdfs:label>
    <rdfs:label xml:lang="zh">评估使用余额</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Links balances used in an aggregate comparison.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/FindingStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">FindingStatus</rdfs:label>
    <rdfs:label xml:lang="zh">异常处理状态</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">A workflow state of an audit finding.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
    <rdfs:subClassOf rdf:resource="https://example.org/cabot-audit/ontology/ControlledConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/interpretationText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">interpretationText</rdfs:label>
    <rdfs:label xml:lang="zh">原因建议文本</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">A proposed contextual explanation requiring evidence and review.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/allocationCredit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/cabot-audit/ontology/CreditAllocation"/>
    <rdfs:range rdf:resource="https://example.org/cabot-audit/ontology/CreditMemo"/>
    <rdfs:label xml:lang="en">allocationCredit</rdfs:label>
    <rdfs:label xml:lang="zh">分配对应贷项</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Identifies the credit memo being applied.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/ReviewDisposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ReviewDisposition</rdfs:label>
    <rdfs:label xml:lang="zh">审核结论</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">A human disposition such as confirmed, rejected or needs evidence.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
    <rdfs:subClassOf rdf:resource="https://example.org/cabot-audit/ontology/ControlledConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/Supplier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Supplier</rdfs:label>
    <rdfs:label xml:lang="zh">供应商</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">An organization supplying goods or services in the reconciliation context.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
    <rdfs:subClassOf rdf:resource="https://example.org/cabot-audit/ontology/Organization"/>
    <skos:altLabel xml:lang="en">Vendor</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/REC-01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/AuditRule"/>
    <sca:ruleId>REC-01</sca:ruleId>
    <sca:ruleVersion>0.1.0-dev</sca:ruleVersion>
    <rdfs:label xml:lang="en">REC-01</rdfs:label>
    <rdfs:label xml:lang="zh">供应商侧发票存在性</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">An observation is present in a supplier snapshot and unmatched in the comparable complete Cabot snapshot. Does not prove non-submission.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
    <rdfs:seeAlso rdf:resource="https://example.org/cabot-audit/ontology/SupplierOnlyRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/observedPaidAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">observedPaidAmount</rdfs:label>
    <rdfs:label xml:lang="zh">观察已付金额</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The paid amount asserted by one source for the observation.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/observationForAccount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/cabot-audit/ontology/RecordObservation"/>
    <rdfs:range rdf:resource="https://example.org/cabot-audit/ontology/SupplierAccount"/>
    <rdfs:label xml:lang="en">observationForAccount</rdfs:label>
    <rdfs:label xml:lang="zh">记录所属账户</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Identifies the account to which a source observation relates.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/Exact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/MatchMethod"/>
    <rdfs:label xml:lang="en">Exact</rdfs:label>
    <rdfs:label xml:lang="zh">精确匹配</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The Exact value in the MatchMethod vocabulary.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/Invoice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Invoice</rdfs:label>
    <rdfs:label xml:lang="zh">发票</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">A document requesting payment for supplied goods or services.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
    <rdfs:subClassOf rdf:resource="https://example.org/cabot-audit/ontology/FinancialDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/Explained">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/ReviewDisposition"/>
    <rdfs:label xml:lang="en">Explained</rdfs:label>
    <rdfs:label xml:lang="zh">已解释</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The Explained value in the ReviewDisposition vocabulary.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/NeedsEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/ReviewDisposition"/>
    <rdfs:label xml:lang="en">NeedsEvidence</rdfs:label>
    <rdfs:label xml:lang="zh">待补证据</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The NeedsEvidence value in the ReviewDisposition vocabulary.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/Rejected">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/cabot-audit/ontology/ReviewDisposition"/>
    <rdfs:label xml:lang="en">Rejected</rdfs:label>
    <rdfs:label xml:lang="zh">已驳回</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">The Rejected value in the ReviewDisposition vocabulary.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/creditFaceAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">creditFaceAmount</rdfs:label>
    <rdfs:label xml:lang="zh">贷项票面额</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Face amount of a credit memo in its explicit currency.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/matchCabotRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/cabot-audit/ontology/MatchDecision"/>
    <rdfs:range rdf:resource="https://example.org/cabot-audit/ontology/InternalAPRecord"/>
    <rdfs:label xml:lang="en">matchCabotRecord</rdfs:label>
    <rdfs:label xml:lang="zh">匹配企业记录</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">Identifies the enterprise-side observation, if present.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/SourceDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">SourceDataset</rdfs:label>
    <rdfs:label xml:lang="zh">来源数据快照</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">An immutable identified snapshot used as reconciliation evidence.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/isSynthetic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">isSynthetic</rdfs:label>
    <rdfs:label xml:lang="zh">合成数据标记</rdfs:label>
    <ns1:IAO_0000115 xml:lang="en">True when an individual is a test fixture rather than business evidence.</ns1:IAO_0000115>
    <rdfs:isDefinedBy rdf:resource="https://example.org/cabot-audit/ontology/scaudit.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/cabot-audit/ontology/snapshotForScope">
